# ==========================================
# Database Configuration (PostgreSQL + PostGIS)
# ==========================================
POSTGRES_USER=homematch_user
POSTGRES_PASSWORD=homematch_password
POSTGRES_DB=homematch_db
# In Docker, port 5432 is bound to 127.0.0.1 for secure local access on the host
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Backend Connection String (For local run outside Docker, use Host=localhost)
ConnectionStrings__DefaultConnection=

# ==========================================
# Backend API Configuration (ASP.NET Core)
# ==========================================
# Set to 'Production' on VPS, 'Development' locally
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
API_PORT=5000

# JWT Authentication
# Mandatory on Production: generate 32 random bytes in base64: openssl rand -base64 32
Jwt__Secret=
Jwt__Issuer=HomeMatch
Jwt__Audience=HomeMatchApp
Jwt__ExpirationMinutes=15
Jwt__ClockSkewSeconds=30

# CORS Allowed Origins
# For local dev:
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost
# For VPS Production:
# Cors__AllowedOrigins__0=https://homematch2005.id.vn
# Cors__AllowedOrigins__1=https://www.homematch2005.id.vn

# Identity & Email Verification Keys
Identity__EmailVerification__Enabled=true
Identity__EmailVerification__KeyId=v1
# Mandatory on Production: generate 32 random bytes in base64: openssl rand -base64 32
Identity__EmailVerification__Keys__v1=

# SMTP Email Configuration (Optional / If sending emails)
Email__Enabled=false
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=
Email__Smtp__FromAddress=
Email__Smtp__AppPassword=
Email__Smtp__FromName=HomeMatch
Email__Smtp__TimeoutSeconds=15

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
FRONTEND_PORT=3000
# For local development: http://localhost:5000
# For VPS with Cloudflare + Nginx reverse proxy: https://homematch2005.id.vn (or leave empty)
NEXT_PUBLIC_API_URL=http://localhost:5000
API_INTERNAL_URL=http://backend:5000

# ==========================================
# Nginx Reverse Proxy & Forwarded Headers
# ==========================================
NGINX_PORT=80
NGINX_SSL_PORT=443
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# ==========================================
# Cloudflare R2 Object Storage (Future)
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=homematch-assets
R2_PUBLIC_DOMAIN=https://assets.homematch.vn
