# ==========================================
# Database Configuration (PostgreSQL + PostGIS)
# ==========================================
POSTGRES_USER=homematch_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=homematch_db
# Mặc định dùng 5433 trên máy host để tránh đụng độ với PostgreSQL cài sẵn ở cổng 5432
POSTGRES_PORT=5433
POSTGRES_HOST=db

# Backend Connection String (Bên trong mạng Docker dùng Host=db;Port=5432)
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=homematch_db;Username=homematch_user;Password=CHANGE_ME_STRONG_DB_PASSWORD;

# ==========================================
# Backend API Configuration (ASP.NET Core .NET 10)
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
API_PORT=5000
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# JWT Authentication (Bắt buộc đặt chuỗi ngẫu nhiên tối thiểu 32 ký tự, không dùng giá trị mẫu trên production)
Jwt__Secret=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_BASE64_SECRET_KEY
Jwt__Issuer=HomeMatch
Jwt__Audience=HomeMatchApp
Jwt__ExpirationMinutes=1440
Jwt__ClockSkewSeconds=30

# CORS Allowed Origins (Hỗ trợ cả Localhost & Production Domain)
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://127.0.0.1:3000
Cors__AllowedOrigins__2=http://localhost
Cors__AllowedOrigins__3=https://homematch2005.id.vn
Cors__AllowedOrigins__4=https://www.homematch2005.id.vn

# Email Settings (Gmail SMTP - để trống nếu chỉ test local dev mock log)
EMAIL_SENDER_EMAIL=
EMAIL_APP_PASSWORD=
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__FromName=HomeMatch Support

# ==========================================
# Frontend Configuration (Next.js 15)
# ==========================================
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
# Để trống để Frontend tự động nhận diện (Localhost:5000 hoặc qua Nginx Reverse Proxy)
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://backend:5000

# ==========================================
# Nginx Reverse Proxy Configuration
# ==========================================
NGINX_PORT=80
NGINX_SSL_PORT=443
# Dùng nginx.conf cho môi trường local HTTP; đổi sang nginx.ssl.conf khi triển khai VPS với Cloudflare Full (Strict) SSL
NGINX_CONF=nginx.conf

# ==========================================
# Cloudflare R2 Object Storage (Future)
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=homematch-media
R2_PUBLIC_DOMAIN=https://assets.homematch.vn

# ==========================================
# VNPay Payment Gateway Configuration
# ==========================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/billing/payment-callback

# ==========================================
# Billing Background Jobs Configuration
# ==========================================
BILLING_JOB_INTERVAL_MINUTES=30
