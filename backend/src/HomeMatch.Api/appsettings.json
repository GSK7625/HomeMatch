{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "HomeMatch",
    "Audience": "HomeMatchApp",
    "ExpirationMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "Identity": {
    "EmailVerification": { "KeyId": "v1" },
    "Sessions": {
      "NormalLifetimeHours": 24,
      "RememberLifetimeDays": 30
    }
  },
  "Email": {
    "Enabled": false,
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Security": "StartTls",
      "FromName": "HomeMatch",
      "TimeoutSeconds": 15
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
